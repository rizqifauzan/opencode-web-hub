# required: login password for the hub (this grants shell access, make it long)
HUB_PASSWORD=change-me

# GitHub OAuth App client id with "Enable Device Flow" ticked
# (GitHub > Settings > Developer settings > OAuth Apps). Optional: you can paste a PAT in the UI instead.
GITHUB_CLIENT_ID=

# optional: preset token, skips the connect step
GITHUB_TOKEN=

# LLM provider keys for opencode, e.g.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
